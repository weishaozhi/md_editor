# Backend environment variables — copy this file to `.env` and edit.
# `.env` is git-ignored; do not commit it.

# Database (default: local SQLite). For production, switch to Postgres:
#   DATABASE_URL=postgresql+asyncpg://user:pass@host:5432/md_editor
DATABASE_URL=sqlite+aiosqlite:///./md_editor.db

# JWT signing key — MUST be replaced in production.
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=replace-me-with-a-long-random-string
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# Filesystem workspace where markdown content is stored.
WORKSPACE_PATH=./workspace

# CORS: comma-separated list of allowed origins.
# Production MUST replace the defaults with real domains.
#   Examples:
#     CORS_ALLOW_ORIGINS=https://md.your.domain
#     CORS_ALLOW_ORIGINS=https://md.your.domain,https://admin.your.domain
# Only when DEBUG=True is the special value "*" accepted (and credentials are then
# disabled by code). Setting "*" with DEBUG=False will fail at startup.
CORS_ALLOW_ORIGINS=http://localhost:5173,http://localhost:3000

# Toggle verbose error responses. NEVER enable in production.
DEBUG=False
